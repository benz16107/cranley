---
import '../styles/base.css'
import Mark from '../components/Mark.astro'
import { LINKS, TEAM } from '../site/links'
import { TRACKS } from '../site/tracks'
interface Props { title: string; description: string; nav?: 'home' | 'how' | 'tools' | 'tracks' }
const { title, description, nav } = Astro.props
const realVisuals = process.env.CRANLEY_REAL_VISUALS === '1'
const url = new URL(Astro.url.pathname, Astro.site)
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {import.meta.env.PUBLIC_INDEX !== '1' && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // the colour scheme chosen in the docs carries over to these pages
      document.documentElement.classList.add('js') // lets the styles hold a diagram back until it is on screen
      try { var t = localStorage.getItem('starlight-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Cranley, home"><Mark />Cranley</a>
        <nav aria-label="Main">
          <a href="/how/" aria-current={nav === 'how' ? 'page' : undefined}>How it works</a>
          <a href="/tools/" aria-current={nav === 'tools' ? 'page' : undefined}>Tools</a>
          <a href="/tracks/" aria-current={nav === 'tracks' ? 'page' : undefined}>Tracks</a>
          <a href="/docs/">Docs</a>
        </nav>
        <a class="btn sm" href={LINKS.github}>GitHub</a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="wrap">
        <nav aria-label="Tracks"><span>Tracks</span>{TRACKS.map((t) => <a href={`/tracks/${t.slug}/`}>{t.name}</a>)}</nav>
        <nav aria-label="Site">
          <span>Built by {TEAM.map((m, i) => <>{i > 0 && ', '}{m.href ? <a href={m.href}>{m.name}</a> : m.name}</>)} at HackPrinceton, fall 2026</span>
          <a href="/how/">How it works</a>
          <a href="/about/">About</a>
          <a href="/docs/">Docs</a>
          <a href={LINKS.github}>GitHub</a>
          {LINKS.devpost && <a href={LINKS.devpost}>Devpost</a>}
          {LINKS.video && <a href={LINKS.video}>Video</a>}
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </nav>
        <p>{realVisuals
          ? 'Screens of the product on this site show Matterport, Vexcel and CoStar content with CoStar\'s permission. No data files are published here.'
          : 'No CoStar, Matterport or Vexcel file or picture appears on this site. Its pictures show made-up test scans, our own drawings, and replies people sent us with their names blurred. One recorded phone call on the Photon page reads out results for a real home, with its address bleeped.'}</p>
      </div>
    </footer>
  </body>
</html>
