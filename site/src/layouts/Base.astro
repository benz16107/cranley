---
import '../styles/base.css'
import Mark from '../components/Mark.astro'
import { LINKS } from '../site/links'
import { TRACKS } from '../site/tracks'
interface Props { title: string; description: string; nav?: 'home' | 'tracks' }
const { title, description, nav } = Astro.props
const realVisuals = process.env.CRANLEY_REAL_VISUALS === '1'
const url = new URL(Astro.url.pathname, Astro.site)
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {import.meta.env.PUBLIC_INDEX !== '1' && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // the colour scheme chosen in the docs carries over to these pages
      try { var t = localStorage.getItem('starlight-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Cranley, home"><Mark />Cranley</a>
        <nav aria-label="Main">
          <a class="wide" href="/#how">How it works</a>
          <a class="wide" href="/#tools">Tools</a>
          <a class="wide" href="/#ecosystem">Ecosystem</a>
          <a href="/tracks/" aria-current={nav === 'tracks' ? 'page' : undefined}>Tracks</a>
          <a href="/docs/">Docs</a>
        </nav>
        <a class="btn sm" href={LINKS.github}>GitHub</a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="wrap">
        <div class="note">
          <a class="brand" href="/"><Mark />Cranley</a>
          <p>Built at HackPrinceton Fall 2026, November 13 to 15. The code name <code>threshold</code> stays on the package, the command line and the MCP server.</p>
          <p>{realVisuals
            ? 'Screens of the product on this site show Matterport, Vexcel and CoStar content with CoStar\'s permission. No data files are published here.'
            : 'No CoStar, Matterport or Vexcel data appears on this site. Its pictures show made-up test scans and our own drawings.'}</p>
        </div>
        <nav aria-label="Product">
          <h2>Product</h2>
          <ul>
            <li><a href="/#how">How it works</a></li>
            <li><a href="/#tools">Tools by who they are for</a></li>
            <li><a href="/#ecosystem">Ecosystem</a></li>
            <li><a href="/#hardware">Hardware</a></li>
            <li><a href="/tracks/">Tracks</a></li>
          </ul>
        </nav>
        <nav aria-label="Docs">
          <h2>Docs</h2>
          <ul>
            <li><a href="/docs/getting-started/">Getting started</a></li>
            <li><a href="/docs/tools/">Tool reference</a></li>
            <li><a href="/docs/mcp/">MCP server and CLI</a></li>
            <li><a href="/docs/reference/api/">HTTP API</a></li>
            <li><a href="/docs/data-sources/">Data sources and licences</a></li>
            <li><a href="/docs/faq/">FAQ</a></li>
          </ul>
        </nav>
        <nav aria-label="Project">
          <h2>Project</h2>
          <ul>
            <li><a href={LINKS.github}>GitHub</a></li>
            {LINKS.devpost && <li><a href={LINKS.devpost}>Devpost</a></li>}
            {LINKS.video && <li><a href={LINKS.video}>Video</a></li>}
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
