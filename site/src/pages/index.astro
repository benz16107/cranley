---
// Home: the headline, the drawing, three steps, who it is for, and one line of proof. The long version is /how/.
// Every count and measurement is read from src/generated/site.json.
import Base from '../layouts/Base.astro'
import PlanFigure from '../components/PlanFigure.astro'
import HomeSteps from '../components/HomeSteps.astro'
import Slot from '../components/Slot.astro'
import site from '../generated/site.json'
import { LINKS, DEMO } from '../site/links'
import { LABELS, filesOf, type SlotId } from '../site/slots'

// The headline: the first is the one in use. To swap, change the 0. The page title follows it.
const HEADLINES = ['Ask anything about a building. Get a measured answer.', 'Know the building before you commit.', 'Every building question, answered with a measurement.']
const headline = HEADLINES[0]
const line = 'Cranley is an agent that picks the right tools for your question and measures the real building, inside and out, before you sign, lease or move in.'
const c = site.counts
const n = site.asked_counts
// real screens of the app, shown once the media pass adds their files (src/site/slots.ts)
const screens: SlotId[] = ['building-view', 'result-drawer', 'agent-lanes']
const showScreens = LABELS || screens.some((id) => filesOf(id).length > 0)
// who to name in each group; the titles themselves come from the personas
const SHOW = ['wheelchair_user', 'furniture_mover', 'car_owner', 'fire_captain', 'houston_homeowner_storm', 'la_quake_prep', 'renter_listing', 'parent_young_kids',
  'remote_worker', 'office_tenant', 'retail_site_selector', 'truck_dispatcher', 'costar_researcher', 'insurance_underwriter']
---
<Base title={`Cranley: ${headline}`} description={line} nav="home">
  <section class="hero">
    <div class="wrap">
      <div class="pitch">
        <h1>{headline.split(/(?<=\.) /).map((sentence) => <span>{sentence} </span>)}</h1>
        <p class="lead">{line}</p>
        <p class="cta">
          {LINKS.demo && <a class="btn solid" href={LINKS.demo}>{DEMO.label}</a>}
          <a class:list={['btn', { solid: !LINKS.demo }]} href="/docs/">Read the docs</a>
        </p>
        {LINKS.demo && <p class="demo-note">{DEMO.notice}</p>}
      </div>
      <Slot id="hero-loop"><PlanFigure /></Slot>
    </div>
  </section>

  <section class="band" id="what">
    <div class="wrap">
      <h2>What it does</h2>
      <HomeSteps />
      {showScreens && <div class="screens">{screens.map((id) => <Slot id={id} />)}</div>}
      <Slot id="iphone-app" phones />
      <p class="more"><a href="/how/">How it works, in full</a></p>
    </div>
  </section>

  <section class="band" id="who">
    <div class="wrap">
      <h2>Who it is for</h2>
      <ul class="who">
        {site.groups.map((g) => (
          <li>
            <a href="/how/#tools"><b>{g.title}</b><span class="num">{g.personas.length}</span></a>
            <span>{g.personas.filter((p) => SHOW.includes(p.id)).map((p) => p.title).join(', ')}</span>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/docs/reference/personas/">All {c.personas} kinds of user</a> · <a href="/docs/tools/">All {c.tools} tools</a></p>
    </div>
  </section>

  <section class="band" id="asked">
    <div class="wrap">
      <p class="asked">We asked first, then built: 1 recorded {n.minutes}-minute interview, written answers from {n.people} people in {n.communities} online communities, and {n.emails} emails. <a href="/tracks/peri/">What people told us</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(32px, 5vw, 72px) clamp(40px, 6vw, 80px); }
  .hero .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-6) var(--s-8); align-items: center; }
  /* two sentences of about 25 characters each: at this size each one sets in two lines of the half-width column */
  .hero h1 { font-size: clamp(2rem, 1rem + 2.8vw, 3rem); font-stretch: 108%; letter-spacing: -0.025em; line-height: 1.06; }
  .hero h1 span { display: block; text-wrap: balance; } /* a line breaks between sentences, never inside one phrase */
  .hero .lead { margin-top: var(--s-5); color: var(--ink-2); max-width: 40ch; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .demo-note { margin-top: var(--s-3); font-size: 0.8125rem; line-height: 1.45; color: var(--ink-3); max-width: 50ch; }
  .hero :global(.slot-note) { margin-top: var(--s-2); }
  @media (max-width: 900px) { .hero .wrap { grid-template-columns: minmax(0, 1fr); } }

  .band { padding-block: clamp(32px, 5vw, 64px); }
  .band h2 { font-size: var(--t-h2); font-stretch: 106%; margin-bottom: var(--s-6); }
  .more { margin-top: var(--s-6); font-size: 0.9375rem; }
  .screens { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5); margin-top: var(--s-7); }
  .band :global(.phones) { margin-top: var(--s-7); }
  @media (max-width: 820px) { .screens { grid-template-columns: minmax(0, 1fr); } }

  .who { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--s-5); border-top: 1px solid var(--rule-strong); padding-top: var(--s-4); }
  .who li { display: grid; gap: 6px; align-content: start; font-size: 0.875rem; line-height: 1.45; color: var(--ink-2); }
  .who a { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-2); color: var(--ink); text-decoration: none; }
  .who b { font-weight: 580; font-size: 0.9375rem; }
  .who .num { color: var(--ink-3); }
  @media (hover: hover) and (pointer: fine) { .who a:hover b { color: var(--accent); } }
  @media (max-width: 900px) { .who { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .who { grid-template-columns: minmax(0, 1fr); } }

  .asked { font-size: var(--t-lead); line-height: 1.5; max-width: 62ch; padding-top: var(--s-5); border-top: 1px solid var(--rule-strong); }
</style>
