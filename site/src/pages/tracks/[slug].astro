---
// One sponsor track. The body is the track's section of docs/story.md (src/content/tracks, written by
// scripts/generate.py); the links and the demo slots come from src/site/tracks.ts.
import { getEntry, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Slot from '../../components/Slot.astro'
import Proof from '../../components/Proof.astro'
import { INTERVIEW } from '../../site/proof'
import Costar from '../../components/deep/Costar.astro'
import Peri from '../../components/deep/Peri.astro'
import { TRACKS } from '../../site/tracks'
import { LABELS, filesOf } from '../../site/slots'

export function getStaticPaths() {
  return TRACKS.map((track) => ({ params: { slug: track.slug }, props: { track } }))
}
const { track } = Astro.props
const entry = await getEntry('tracks', track.slug)
const Content = entry ? (await render(entry)).Content : null
// the tracks redesigned as deep dives; the rest keep the page below until theirs is built
const Deep = ({ costar: Costar, peri: Peri } as Record<string, typeof Costar>)[track.slug]
const title = entry?.data.title ?? `${track.name}: ${track.prize}`
const shots = track.slots.filter((id) => LABELS || filesOf(id).length > 0)
---
{Deep ? <Deep track={track} title={title}>{Content && <Content />}</Deep> : (
<Base title={`${track.name}: Cranley`} description={track.summary} nav="tracks">
  <article class="page">
    <div class="wrap">
      <p class="small"><a href="/tracks/">Tracks</a></p>
      <h1>{entry?.data.title ?? `${track.name}: ${track.prize}`}</h1>
      <p class="intro">{track.summary}</p>
      <div class="prose">
        {track.interview && (
          <figure class="video" id="interview">
            <iframe src={INTERVIEW.embed} title={INTERVIEW.title} loading="lazy" allow="encrypted-media; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            <figcaption>{INTERVIEW.caption} <a href={INTERVIEW.url}>Watch it on YouTube</a></figcaption>
          </figure>
        )}
        {Content && <Content />}
        {track.proof && (
          <>
            <h2 id="proof">From the people we asked</h2>
            {track.proof.map((id) => <Proof id={id} />)}
          </>
        )}
        {shots.length > 0 && (
          <>
            <h2>The demo</h2>
            <div class="shots">{shots.map((id) => <Slot id={id} phones={id === 'field-visit' || id === 'iphone-app'} />)}</div>
          </>
        )}
        <h2>In the docs</h2>
        <ul>{track.docs.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
      </div>
    </div>
  </article>
</Base>
)}

<style>
  .video { display: grid; gap: var(--s-2); }
  .video iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: var(--r-2); background: var(--pane); }
  .video figcaption { font-size: 0.875rem; color: var(--ink-2); max-width: 70ch; }
  .shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5) var(--s-4); }
  .shots :global(.phones) { grid-column: 1 / -1; }
  @media (max-width: 620px) { .shots { grid-template-columns: minmax(0, 1fr); } }
</style>
