---
// A data flow in columns. Pointing at a step, or tabbing to it, puts what it does in the line underneath.
interface Props { cols: { label: string; nodes: { title: string; what: string; note: string }[] }[] }
const { cols } = Astro.props
const first = cols[0].nodes[0]
let n = 0
---
<div class="flow" data-scope data-play>
  <div class="cols">
    {cols.map((col, ci) => (
      <>
        {ci > 0 && <svg class="arrow" viewBox="0 0 40 12" aria-hidden="true"><path d="M1 6h36m-5-4 5 4-5 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>}
        <div class="col">
          <p class="col-l">{col.label}</p>
          {col.nodes.map((node) => (
            <button type="button" class="node" data-say={`${node.title}. ${node.note}`} data-on={n === 0 ? '' : undefined} style={`--i: ${n++}`}>
              <b>{node.title}</b><span>{node.what}</span>
            </button>
          ))}
        </div>
      </>
    ))}
  </div>
  <p class="readout" aria-live="polite">{first.title}. {first.note}</p>
</div>

<style>
  .flow { display: grid; gap: var(--s-4); }
  .cols { display: flex; align-items: center; gap: var(--s-2); }
  .col { flex: 1 1 0; min-width: 0; align-self: stretch; display: grid; align-content: start; gap: var(--s-2); padding: var(--s-4); background: var(--pane); border: 1px solid var(--rule); border-radius: var(--r-2); }
  .col-l { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 2px; }
  .arrow { flex: 0 0 40px; width: 40px; color: var(--ink-3); }
  .node { display: grid; gap: 2px; padding: 10px 12px; text-align: start; font: inherit; color: inherit; background: var(--paper); border: 1px solid var(--rule-strong); border-radius: var(--r-1); cursor: pointer; transition: border-color var(--dur-1) ease, background-color var(--dur-1) ease; }
  .node b { font-weight: 600; font-size: 0.9375rem; line-height: 1.3; }
  .node span { font-size: 0.8125rem; line-height: 1.4; color: var(--ink-2); }
  .node[data-on] { border-color: var(--accent); background: var(--accent-wash); }
  .node:active { scale: 0.98; }
  /* the page's one moving moment: the steps arrive in the order the data travels */
  :global(.js) .flow:not([data-seen]) .node { opacity: 0; translate: 0 8px; }
  :global(.js) .flow[data-seen] .node { transition: opacity 420ms var(--ease-out) calc(var(--i) * 55ms), translate 420ms var(--ease-out) calc(var(--i) * 55ms), border-color var(--dur-1) ease, background-color var(--dur-1) ease; }
  @media (max-width: 760px) {
    .cols { flex-direction: column; align-items: stretch; }
    .arrow { align-self: center; rotate: 90deg; flex-basis: 16px; height: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .flow:not([data-seen]) .node { translate: none; }
    :global(.js) .flow[data-seen] .node { transition: opacity 200ms ease; }
  }
</style>
