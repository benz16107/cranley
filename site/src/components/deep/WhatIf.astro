---
// A what-if, before and after: the renovate tool's own run on the made-up test home (src/generated/deep.json).
// The switch changes which count the strip shows; nothing here is typed.
import deep from '../../generated/deep.json'
const m = Object.fromEntries(deep.numbers.renovate.metrics.map((x) => [x.id, x]))
const before = m.failing_before.value, after = m.failing_after.value
const edits = deep.numbers.renovate.metrics.filter((x) => /^e\d+\/fixed$/.test(x.id)).map((x) => ({ label: x.label, fixed: x.value, cost: m[x.id.replace('fixed', 'cost')].value }))
const cells = Array.from({ length: Math.max(before, after) }, (_, i) => i)
---
<div class="whatif" data-state="now">
  <div class="switch" role="group" aria-label="Which state to show">
    <button type="button" data-set="now" aria-pressed="true">Now</button>
    <button type="button" data-set="after" aria-pressed="false">After the edits</button>
  </div>
  <div class="strip" aria-hidden="true">{cells.map((i) => <i class:list={{ gone: i >= after }}></i>)}</div>
  <p class="count"><span class="now"><span class="num">{before}</span> checks failing on the made-up test home</span><span class="after"><span class="num">{after}</span> checks failing after the edits, for an estimated <span class="num">${m.total_cost.value.toLocaleString('en-US')}</span></span></p>
  <table>
    <thead><tr><th>Edit</th><th class="r">Checks it fixes</th><th class="r">Estimated cost</th></tr></thead>
    <tbody>{edits.map((e) => <tr><td>{e.label}</td><td class="r num">{e.fixed}</td><td class="r num">${e.cost.toLocaleString('en-US')}</td></tr>)}</tbody>
  </table>
</div>

<script is:inline>
  document.addEventListener('click', (e) => {
    const b = e.target.closest && e.target.closest('.whatif [data-set]')
    if (!b) return
    const box = b.closest('.whatif')
    box.dataset.state = b.dataset.set
    box.querySelectorAll('[data-set]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
  })
</script>

<style>
  .whatif { display: grid; gap: var(--s-4); }
  .switch { display: inline-flex; justify-self: start; padding: 2px; background: var(--pane-2); border-radius: 999px; }
  .switch button { padding: 5px 14px; font: inherit; font-size: 0.875rem; color: var(--ink-2); background: none; border: 0; border-radius: 999px; cursor: pointer; transition: background-color var(--dur-2) ease, color var(--dur-2) ease; }
  .switch button[aria-pressed='true'] { background: var(--pane); color: var(--ink); box-shadow: 0 0 0 1px var(--rule-strong); }
  .switch button:active { scale: 0.97; }
  .strip { display: flex; flex-wrap: wrap; gap: 4px; }
  .strip i { width: 18px; height: 18px; border-radius: 2px; background: var(--fail); transition: background-color 260ms var(--ease-out), box-shadow 260ms var(--ease-out); }
  /* after the edits these checks no longer fail: an outline is what is left of them */
  .whatif[data-state='after'] .strip i.gone { background: transparent; box-shadow: inset 0 0 0 1.5px var(--rule-strong); }
  .count { font-size: 0.9375rem; }
  .count .num { font-size: 1.125rem; color: var(--ink); }
  .whatif[data-state='now'] .after, .whatif[data-state='after'] .now { display: none; }
  table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  th { text-align: start; font-weight: 600; font-size: 0.8125rem; color: var(--ink-3); border-bottom: 1px solid var(--rule-strong); }
  th, td { padding: 8px 12px 8px 0; border-bottom: 1px solid var(--rule); }
  .r { text-align: end; padding-right: 0; }
  @media (prefers-reduced-motion: reduce) { .strip i { transition: none; } }
</style>
