---
// The Photon track. Sentences are docs/story.md's. The message thread is our own drawing of the flow: it shows no
// real conversation, address or building.
import Deep from "./Deep.astro"
import Sec from "./Sec.astro"
import Chart from "./Chart.astro"
import Flow from "./Flow.astro"
import Cards from "./Cards.astro"
import Bars from "./Bars.astro"
import Split from "./Split.astro"
import Lanes from "./Lanes.astro"
import Asked from "./Asked.astro"
import Products from "./Products.astro"
import deep from "../../generated/deep.json"
import site from "../../generated/site.json"
import type { Track } from "../../site/tracks"
interface Props { track: Track; title: string }
const { track, title } = Astro.props
const c = site.counts
const md = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/`([^`]+)`/g, "<code>$1</code>")
import Thread from "./Thread.astro"
import CallPlayer from "./CallPlayer.astro"
import call from "../../site/call.json"
import { LABELS } from "../../site/slots"
const sp = deep.sponsors.photon
const stats = [{ n: sp.features.length, label: "things a person can do by message or by calling" }, { n: deep.numbers.photon.tests, label: "tests merged with it" }]
const features = sp.features.map((f) => ({ title: f.feature, what: f.why, code: f.code }))
// the recorded call: src/site/call.json holds its label, the audio's address under /media and the timeline. Until
// they are filled in, the section shows only on a build that keeps the slot notes (a preview), never on the public site.
const hasCall = Boolean(call.audio) && call.timeline.length > 0
const showCall = hasCall || LABELS
const sections: [string, string][] = [["asked", "Asked and built"], ["problem", "Problem"], ["built", "A conversation"], ...(showCall ? [["call", "A recorded call"] as [string, string]] : []), ["features", "Products used"], ["rules", "Rules it keeps"], ["limits", "Limits"], ["writeup", "Write-up"], ["docs", "In the docs"]]
const msgs = [
  { from: "person" as const, text: "Will an F-150 fit in this garage?", note: "A person asks in plain words, with a link to the building. This uses the shared iMessage line with native replies and a typing indicator." },
  { from: "cranley" as const, kind: "Picture and verdict", text: "The floor plan marked with what was found, then the verdict, the measurements and a link to the workspace.", note: "Every sent line is built from the tool result, never from model text. Only rendered pictures leave the server, sent by attachment upload." },
  { from: "person" as const, text: "What about two?", note: "A reply to an earlier answer. The reply thread is the investigation: parentMessageId in and out." },
  { from: "cranley" as const, kind: "Approval", text: "A slow step asks before it runs.", note: 'The person says "yes", "no" or "always" to a slow step: approvals by native reply.' },
  { from: "person" as const, text: "yes", note: 'The person says "yes", "no" or "always" to a slow step: approvals by native reply.' },
  { from: "person" as const, text: "report", note: 'The person types "report".' },
  { from: "cranley" as const, kind: "PDF", text: "The report, ready to forward.", note: "The PDF arrives in the chat, ready to forward." },
  { from: "person" as const, kind: "A phone call", text: "Calls the number and asks the same.", note: "An ElevenLabs agent over SIP runs the same checks by voice. The plan and the link follow in iMessage after the call." },
]
---
<Deep track={track} title={title} sections={sections} stats={stats}>
  <Sec id="asked" title="What Photon asked for, and what we built" sub="The brief asks for a messaging agent on Photon 2.0, with a separate prize for voice. Both are built, and the voice agent has answered a real phone call. A full round trip through iMessage is not confirmed yet, and this page says so.">
    <Asked sponsor="Photon" source="The two asks are the prize names on the event's Devpost page: a messaging agent using Photon 2.0, and Best Voice Agent."
      asked={[
        { text: 'A messaging agent using Photon 2.0', met: false, how: `Built and merged with ${deep.numbers.photon.tests} tests. The live line is up, with sends limited to an allowlist of numbers. After the first real call Cranley sent the plan and the answer by iMessage: Photon accepted the sends and reported no delivery receipt, so a full round trip is not confirmed.` },
        { text: 'A voice agent', met: false, how: 'An ElevenLabs agent runs the same checks by voice. In the first real phone call, on 15 Nov, it ran the garage check and read the measured answer aloud. A second question in that call got no check.' },
      ]}
      beyond={[
        { n: sp.features.length, text: 'things a person can do by message or by calling' },
        { text: 'It is the same agent, the same measuring tools and the same workspace document as the web app.' },
        { text: 'A reply to an earlier answer continues that investigation.' },
        { text: 'A photo of a doorway with a bank card in it gets measured.' },
        { text: 'Typing "visit" sends the unsettled checks one at a time, and the desktop workspace updates live.' },
        { text: 'Typing "report" brings the PDF into the chat, ready to forward.' },
        { text: 'Every sent line is built from the tool result, never from model text.' },
      ]} />
  </Sec>

  <Sec id="problem" title="Nobody checks a building from a desk" sub="The people who need a building checked are rarely at a desk: they are walking through a viewing, driving to one, or standing in a doorway with a tape measure.">
    <p class="txt">On Photon, the same agent and the same measuring tools answer in iMessage and on a phone call.</p>
  </Sec>

  <Sec id="built" title="One conversation, start to finish" sub="A drawing of the flow, not a real conversation. Select a message to read which part of Photon carries it.">
    <Thread msgs={msgs} />
  </Sec>

  {showCall && (
    <Sec id="call" title="A recorded call, line by line" sub="The audio with its transcript beside it. Each line lights up as it is spoken, and what ran behind the answer appears at the moment it ran.">
      {hasCall
        ? <CallPlayer label={call.label} src={call.audio} timeline={call.timeline} note={call.note} />
        : <p class="slot-note"><b>Slot</b> The call player is built and waits for a recording: its audio in public/media and its label and timeline in src/site/call.json. Hidden on the public site until then.</p>}
    </Sec>
  )}

  <Sec id="features" title="Every Photon product we used, and how" sub="iMessage on Photon 2.0, and voice through an ElevenLabs agent over SIP. Each entry is one thing a person does and the part of Photon that carries it. See the limits below for what is not yet confirmed.">
    <Products features={sp.features} />
  </Sec>

  <Sec id="rules" title="Rules it keeps" sub="A message is a result, so it follows the same rules as the screen.">
    <ul class="txt">
      <li>Every sent line is built from the tool result, never from model text.</li>
      <li>A typed size needs a unit.</li>
      <li>Only rendered pictures leave the server.</li>
      <li>The main API stays private behind one signature-checked relay.</li>
      <li>Each event is handled once, in order per chat.</li>
    </ul>
  </Sec>

  <Sec id="limits" title="Where it stands" sub="As of the early morning of 15 Nov 2026.">
    <ul class="txt">
      <li>The live line is up, with sends limited to an allowlist of numbers.</li>
      <li>The voice line is wired, and Ben made the first real phone call on 15 Nov. The agent ran the garage check and read the measured answer aloud. A second question in the same call got no check.</li>
      <li>After the call Cranley sent the plan picture and the answer to his iMessage thread. Photon accepted the sends and reported no delivery receipt, so a full live round trip is not confirmed yet.</li>
      <li>The recordings of these calls measure a real home, so they are not shown on this site.</li>
    </ul>
  </Sec>

  {track.video && (
    <Sec id="video" title="The track in a video">
      <figure class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${track.video}`} title={`${track.name}: Cranley`} loading="lazy" allow="encrypted-media; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></figure>
    </Sec>
  )}

  <Sec id="writeup" title="The write-up for the judges" sub="The track's section of our story, as written.">
    <div class="prose"><slot /></div>
  </Sec>

  <Sec id="docs" title="In the docs">
    <ul class="docs-links">{track.docs.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
  </Sec>
</Deep>
