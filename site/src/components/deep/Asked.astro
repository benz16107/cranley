---
// What the sponsor asked for, beside what we built past it. Each ask carries the status scale's own mark: a filled
// circle when it is met, a triangle when it is only partly met, with the reason. Nothing is ticked that is not true.
import St from '../St.astro'
interface Props {
  sponsor: string
  /** where the list on the left comes from */
  source: string
  asked: { text: string; met: boolean; how: string }[]
  beyond: { n?: number | string; text: string }[]
}
const { sponsor, source, asked, beyond } = Astro.props
---
<div class="asked">
  <div class="side">
    <p class="k">What {sponsor} asked for</p>
    <ul>
      {asked.map((a) => (
        <li>
          <St status={a.met ? 'pass' : 'warn'} label={a.met ? 'Met' : 'Partly'} />
          <span class="t">{a.text}</span>
          <span class="h">{a.how}</span>
        </li>
      ))}
    </ul>
    <p class="src">{source}</p>
  </div>
  <svg class="arrow" viewBox="0 0 40 12" aria-hidden="true"><path d="M1 6h36m-5-4 5 4-5 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
  <div class="side more">
    <p class="k">What we built beyond it</p>
    <ul>
      {beyond.map((b) => <li class:list={{ counted: b.n !== undefined }}>{b.n !== undefined && <span class="num">{b.n}</span>}<span class="t">{b.text}</span></li>)}
    </ul>
  </div>
</div>

<style>
  .asked { display: grid; grid-template-columns: minmax(0, 5fr) 40px minmax(0, 6fr); gap: var(--s-3); align-items: center; }
  .side { align-self: stretch; display: grid; align-content: start; gap: var(--s-4); padding: var(--s-5); background: var(--pane); border: 1px solid var(--rule); border-radius: var(--r-2); }
  .more { background: var(--accent-wash); border-color: color-mix(in srgb, var(--accent) 30%, transparent); }
  .k { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-3); }
  .more .k { color: var(--accent); }
  ul { display: grid; gap: var(--s-4); }
  .side:not(.more) li { display: grid; grid-template-columns: max-content minmax(0, 1fr); column-gap: var(--s-3); row-gap: 2px; align-items: baseline; }
  .side:not(.more) li :global(.st) { grid-row: span 2; min-width: 4.4em; font-size: 0.8125rem; }
  .t { font-size: 0.9375rem; font-weight: 600; line-height: 1.35; }
  .h { grid-column: 2; font-size: 0.875rem; line-height: 1.45; color: var(--ink-2); }
  .more ul { gap: var(--s-3); }
  .more li { display: grid; grid-template-columns: 3.4ch minmax(0, 1fr); column-gap: var(--s-3); align-items: baseline; }
  .more li:not(.counted) .t { grid-column: 2; }
  .more .t { font-weight: 400; line-height: 1.45; }
  .more .num { font-size: 1.0625rem; font-weight: 500; text-align: end; color: var(--ink); }
  .src { font-size: 0.8125rem; line-height: 1.45; color: var(--ink-3); }
  .arrow { width: 40px; color: var(--ink-3); }
  @media (max-width: 820px) {
    .asked { grid-template-columns: minmax(0, 1fr); }
    .arrow { justify-self: center; rotate: 90deg; height: 16px; }
  }
</style>
