---
// Horizontal bars from zero, longest first, each with its value written beside it.
interface Props { rows: { label: string; n: number; n2?: number; href?: string }[] }
const { rows } = Astro.props
const max = Math.max(...rows.map((r) => r.n + (r.n2 ?? 0)))
---
<ol class="bars" data-play>
  {rows.map((r, i) => (
    <li style={`--v: ${r.n / max}; --v2: ${(r.n2 ?? 0) / max}; --i: ${i}`}>
      <span class="lab">{r.href ? <a href={r.href}>{r.label}</a> : r.label}</span>
      <span class="track"><i></i>{r.n2 ? <i class="second"></i> : null}</span>
      <span class="num">{r.n2 === undefined ? r.n : `${r.n} + ${r.n2}`}</span>
    </li>
  ))}
</ol>
