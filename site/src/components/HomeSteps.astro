---
// What it does, in three steps, each with a small diagram made from the engine's own result on the test home
// (src/generated/site.json). A diagram plays once, the first time it is seen; with scripts or motion off it is
// simply drawn finished.
import site from '../generated/site.json'
import St from './St.astro'
const r = site.home.results
const tools = Object.values(r)
const check = r.door_widths.checks[0]
const src = r.door_widths.source!
const ask = 'I use a wheelchair. Can I reach the bathroom?'
---
<ol class="steps">
  <li data-run>
    <div class="d ask" role="img" aria-label={`A person types: ${ask}`}>
      <p class="field" aria-hidden="true">{[...ask].map((ch, i) => <span style={`--i: ${i}`}>{ch}</span>)}</p>
      <span class="send" aria-hidden="true">Ask</span>
    </div>
    <h3>Say what you need</h3>
    <p>One sentence, in your own words.</p>
  </li>
  <li data-run>
    <div class="d run" role="img" aria-label={`The agent runs ${tools.length} tools: ${tools.map((t) => t.title).join(', ')}.`}>
      <ul aria-hidden="true">
        {tools.map((t, i) => (
          <li style={`--i: ${i}`}>
            <span>{t.title}</span>
            <i class="bar"></i>
            <St status={t.verdict.status as 'fail'} label="" />
          </li>
        ))}
      </ul>
    </div>
    <h3>It picks the tools and measures</h3>
    <p>{site.counts.tools} tools to choose from, many buildings at once.</p>
  </li>
  <li data-run>
    <div class="d see" role="img" aria-label={`Result: ${check.rule}. Measured ${check.measured} ${check.unit}, needs ${check.threshold} ${check.unit}. Measured from the scan, ${src.confidence} reliability.`}>
      <div aria-hidden="true">
        <span class="what" style="--i: 0">{check.rule.replace(/^Doorway width, /, '')}</span>
        <span class="value" style="--i: 1"><b class="num">{check.measured} {check.unit}</b><St status={check.status as 'fail'} /></span>
        <span class="need" style="--i: 2">needs <span class="num">{check.threshold} {check.unit}</span></span>
        <span class="source" style="--i: 3">Measured from the scan · {src.confidence} reliability</span>
      </div>
    </div>
    <h3>See the number and its source</h3>
    <p>Every number comes from a calculation.</p>
  </li>
</ol>

<script>
  // run each diagram once, the first time it is on screen
  const io = new IntersectionObserver((seen) => seen.forEach((e) => {
    if (e.isIntersecting) { (e.target as HTMLElement).dataset.seen = ''; io.unobserve(e.target) }
  }), { threshold: 0.5 })
  document.querySelectorAll('[data-run]').forEach((el) => io.observe(el))
</script>

<style>
  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-6) var(--s-5); counter-reset: step; }
  .steps > li { counter-increment: step; display: grid; gap: var(--s-2); align-content: start; }
  h3 { font-size: 1.0625rem; letter-spacing: -0.01em; margin-top: var(--s-3); }
  h3::before { content: counter(step); margin-right: 0.7em; font: 500 0.8125rem var(--font-mono); font-stretch: 80%; color: var(--ink-3); }
  .steps > li > p { color: var(--ink-2); font-size: 0.9375rem; }

  .d { aspect-ratio: 16 / 10; display: grid; align-content: center; padding: var(--s-5); border: 1px solid var(--rule); border-radius: var(--r-2); background: var(--pane); }
  .ask { gap: var(--s-3); justify-items: end; }
  .field { width: 100%; min-height: 4.4em; padding: 10px 12px; border: 1px solid var(--rule-strong); border-radius: var(--r-1); background: var(--paper); font-size: 0.9375rem; line-height: 1.45; }
  .send { display: inline-flex; align-items: center; height: 28px; padding: 0 12px; border-radius: var(--r-1); background: var(--ink); color: var(--pane); font-size: 0.8125rem; font-weight: 560; }
  .run ul { display: grid; gap: var(--s-3); }
  .run li { display: grid; grid-template-columns: minmax(0, 11fr) minmax(0, 9fr) 12px; gap: var(--s-3); align-items: center; font-size: 0.875rem; }
  .run li > span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bar { height: 3px; border-radius: 2px; background: var(--accent); transform-origin: left; }
  .see > div { display: grid; gap: 2px; }
  .what { font-size: 0.875rem; color: var(--ink-2); }
  .value { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); font-size: 1.5rem; line-height: 1.2; }
  .value b { font-weight: 600; font-size: 1em; }
  .value :global(.st) { font-size: 0.875rem; }
  .need { font-size: 0.875rem; color: var(--ink-2); }
  .source { margin-top: var(--s-3); padding-top: var(--s-3); border-top: 1px solid var(--rule); font-size: 0.8125rem; color: var(--ink-3); }
  @media (max-width: 820px) { .steps { grid-template-columns: minmax(0, 1fr); max-width: 30rem; } }

  /* Explanation, seen once. Until a diagram is on screen its parts wait; then they arrive in order. Side by side,
     the three play one after another, left to right; stacked on a phone, each plays as it is reached. */
  @media (min-width: 821px) { .steps > li:nth-child(2) { --t0: 900ms; } .steps > li:nth-child(3) { --t0: 1900ms; } }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) [data-run]:not([data-seen]) :is(.field span, .send, .run li > *, .see span) { opacity: 0; }
    [data-seen] .field span { animation: on 1ms calc(var(--i) * 22ms + 150ms) both; }
    [data-seen] .send { animation: on 240ms 1150ms var(--ease-out) both; }
    [data-seen] .run li > span:first-child { animation: on 240ms calc(var(--t0, 0ms) + var(--i) * 70ms) var(--ease-out) both; }
    [data-seen] .bar { animation: fill 480ms calc(var(--t0, 0ms) + var(--i) * 120ms + 220ms) linear both; }
    [data-seen] .run li > :global(.st) { animation: on 200ms calc(var(--t0, 0ms) + var(--i) * 120ms + 700ms) var(--ease-out) both; }
    [data-seen] .see span { animation: on 280ms calc(var(--t0, 0ms) + var(--i) * 80ms + 120ms) var(--ease-out) both; }
  }
  @keyframes on { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fill { from { opacity: 1; transform: scaleX(0); } to { opacity: 1; transform: scaleX(1); } }
</style>
