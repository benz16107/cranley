---
// The hero drawing: the made-up test home, with the route and the door widths the engine returned for it when
// scripts/generate.py last ran. Every number here is read from src/generated/site.json; only the format is ours.
// It plays once: the route draws from the entrance, each doorway is flagged as the line reaches it, and it stops
// at the doorway that fails. The finished drawing is the resting state.
import site from '../generated/site.json'

const home = site.home
const doors = home.results.door_widths
const route = home.routes.find((r) => r.label.endsWith('Bathroom'))!
const checks = doors.checks.map((c) => ({ ...c, opening: home.openings.find((o) => o.id === c.id)! }))
const worst = checks[0] // the tool lists the narrowest failing doorway first: the one in the headline

// Where each doorway's width is written, so it stays off the route and the walls. One not named here sits on its door.
const AT: Record<string, [number, number]> = { o0: [84, -30], o1: [112, -34], o2: [-66, -30], o3: [-60, 0], o4: [-60, 0], o10: [0, 40] }
const ROOM: Record<string, [number, number]> = { 'Living Room': [130, 0], Bathroom: [-30, 60], Hallway: [70, 0] }
const pts = (p: number[][]) => p.map((q) => q.join(',')).join(' ')
// the route as far as the first doorway that fails, then the rest of it
const stop = route.points.findIndex((p) => route.chokes.some((c) => c.status === 'fail' && c.at[0] === p[0] && c.at[1] === p[1]))
const open = stop < 0 ? route.points : route.points.slice(0, stop + 1)
const shut = stop < 0 ? [] : route.points.slice(stop)

// Timing. The line takes DRAW ms on the strong ease-in-out curve; a doorway on the route is flagged when the line
// gets there, so its delay is that curve solved for the distance travelled. The rest follow, 70 ms apart.
const START = 300, DRAW = 1200
const seg = open.slice(1).map((p, i) => Math.hypot(p[0] - open[i][0], p[1] - open[i][1]))
const total = seg.reduce((a, b) => a + b, 0)
const timeAt = (share: number) => { // x of cubic-bezier(0.77, 0, 0.175, 1) where y reaches `share`
  for (let t = 0; t <= 1; t += 0.001) if (3 * (1 - t) * t * t + t ** 3 >= share) return 3 * (1 - t) ** 2 * t * 0.77 + 3 * (1 - t) * t * t * 0.175 + t ** 3
  return 1
}
const onRoute = (o: { c: number[] }) => open.findIndex((p) => Math.hypot(p[0] - o.c[0], p[1] - o.c[1]) < 40)
let later = 0
const flags = checks.map((d) => {
  const i = onRoute(d.opening)
  const at = i >= 0 ? START + DRAW * timeAt(seg.slice(0, i).reduce((a, b) => a + b, 0) / total) : START + DRAW + 260 + 70 * later++
  return { ...d, at: Math.round(at), x: d.opening.c[0] + (AT[d.id]?.[0] ?? 0), y: d.opening.c[1] + (AT[d.id]?.[1] ?? 0), hero: d.id === worst.id }
})
---
<figure class="plan">
  <svg viewBox="-30 -62 1065 890" role="img" aria-label={`Floor plan of a made-up test home with six rooms. A route runs from the entrance towards the bathroom and stops at the bathroom doorway, which is ${worst.measured} metres wide against the ${worst.threshold} metres needed.`}>
    <g class="rooms">
      {home.rooms.map((r) => <text class:list={{ tiny: r.area < 4 }} x={r.c[0] + (ROOM[r.label]?.[0] ?? 0)} y={r.c[1] + (ROOM[r.label]?.[1] ?? 0)} text-anchor="middle">{r.label}</text>)}
    </g>
    <g class="walls">{home.walls.map((w) => <line x1={w.a[0]} y1={w.a[1]} x2={w.b[0]} y2={w.b[1]} />)}</g>
    <g class="gaps">{home.openings.map((o) => <line x1={o.a[0]} y1={o.a[1]} x2={o.b[0]} y2={o.b[1]} />)}</g>
    <g class="glass">{home.openings.filter((o) => !checks.some((d) => d.id === o.id)).map((o) => <line x1={o.a[0]} y1={o.a[1]} x2={o.b[0]} y2={o.b[1]} />)}</g>
    <g class="leaves">{flags.map((d) => <line class:list={['flag', d.status]} style={`--at: ${d.at}ms`} x1={d.opening.a[0]} y1={d.opening.a[1]} x2={d.opening.b[0]} y2={d.opening.b[1]} />)}</g>
    <polyline class="route" points={pts(open)} pathLength="1" />
    {shut.length > 1 && <polyline class="route shut flag" style={`--at: ${START + DRAW + 120}ms`} points={pts(shut)} />}
    <circle class="start" cx={route.points[0][0]} cy={route.points[0][1]} r="9" />
    <g class="widths">
      {flags.map((d) => (
        <g transform={`translate(${d.x} ${d.y})`}>
          <g class:list={['flag', 'pop', d.status, { hero: d.hero }]} style={`--at: ${d.at + (d.hero ? 80 : 0)}ms`}>
            {d.status === 'fail' ? <rect x="-46" y="-9" width="18" height="18" /> : d.status === 'warn' ? <path d="M-37 -11 -26 9H-48Z" /> : <circle cx="-37" r="9.5" />}
            <text x="-20" y="8">{d.measured}</text>
          </g>
        </g>
      ))}
    </g>
  </svg>
  <figcaption>
    <span class="key"><i class="line"></i>Route from the entrance</span>
    <span class="key"><i class="line shut"></i>Too narrow to pass</span>
    <span>A made-up test home, checked for a wheelchair that needs {worst.threshold} {worst.unit}. Every width is the engine's own result. <a href="/how/#numbers">How it measures</a></span>
  </figcaption>
</figure>

<style>
  .plan { min-width: 0; display: grid; gap: var(--s-3); }
  svg { width: 100%; overflow: visible; }
  .rooms text { font: 500 24px var(--font-sans); fill: var(--ink-3); }
  .walls line { stroke: var(--ink); stroke-width: 12; stroke-linecap: square; }
  .gaps line { stroke: var(--paper); stroke-width: 18; }
  .glass line { stroke: var(--ink-3); stroke-width: 3; }
  .leaves line { stroke-width: 6; stroke: var(--pass); }
  .leaves .warn { stroke: var(--warn); }
  .leaves .fail { stroke: var(--fail); }
  .route { fill: none; stroke: var(--accent); stroke-width: 6; stroke-linejoin: round; stroke-linecap: round; }
  .route.shut { stroke: var(--fail); stroke-dasharray: 3 13; }
  .start { fill: var(--accent); }
  .widths :is(rect, path, circle) { fill: var(--pass); }
  .widths .warn path { fill: var(--warn); }
  .widths .fail rect { fill: var(--fail); }
  /* a halo in the paper colour keeps a number readable where it sits near a wall */
  .widths text { font: 600 23px var(--font-mono); font-stretch: 80%; fill: var(--ink); paint-order: stroke; stroke: var(--paper); stroke-width: 8px; stroke-linejoin: round; }
  .widths .hero text { font-size: 30px; fill: var(--fail); }
  figcaption { display: flex; flex-wrap: wrap; gap: 4px var(--s-5); font-size: 0.8125rem; color: var(--ink-3); }
  .key { display: inline-flex; align-items: center; gap: 8px; }
  .key .line { width: 22px; border-top: 3px solid var(--accent); }
  .key .line.shut { border-top: 3px dotted var(--fail); }
  @media (max-width: 560px) {
    .rooms text { font-size: 34px; }
    .rooms .tiny { display: none; }
    /* at phone size only the doorway in the headline keeps its number */
    .widths .pop:not(.hero) text { display: none; }
    .widths .hero text { font-size: 34px; }
  }

  /* The page's one long move. Explanation, seen once: a line that draws (stroke-dashoffset is how a path draws
     itself), then each doorway fades in at the moment the line reaches it. Nothing loops. */
  @media (prefers-reduced-motion: no-preference) {
    .route:not(.shut) { stroke-dasharray: 1; animation: draw 1200ms 300ms var(--ease-in-out) both; }
    .flag { animation: flag 320ms var(--ease-out) both; animation-delay: var(--at); }
    .pop { transform-box: fill-box; transform-origin: center; animation-name: pop; }
  }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes flag { from { opacity: 0; } to { opacity: 1; } }
  @keyframes pop { from { opacity: 0; scale: 0.92; } to { opacity: 1; scale: 1; } }
</style>
