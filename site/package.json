{
  "name": "cranley-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 5381",
    "build": "rm -rf dist .astro node_modules/.astro && astro build",
    "preview": "astro preview --port 5381",
    "generate": "cd ../server && uv run python ../site/scripts/generate.py",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "astro": "7.4.8"
  }
}
